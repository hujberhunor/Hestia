#!/bin/sh
set -eu

case "${1-}" in
    on)
        git config --local --unset hestia.hooks.override 2>/dev/null || true
        printf 'Git hook rules enabled.\n'
        ;;
    off)
        git config --local hestia.hooks.override true
        printf 'Git hook rules overridden locally.\n'
        printf 'Run %s on to restore checks.\n' "$0"
        ;;
    *)
        printf 'Usage: %s on|off\n' "$0" >&2
        exit 64
        ;;
esac
