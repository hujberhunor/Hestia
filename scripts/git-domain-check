#!/bin/sh
set -eu

domain_for_path() {
    case "$1" in
        app/*) printf '%s\n' app ;;
        k3s-stack/*|ansible/*|scripts/*) printf '%s\n' infra ;;
        memory/*|.agent/*|.githooks/*|.github/*) printf '%s\n' memory ;;
        thesis/*) printf '%s\n' thesis ;;
        *) return 1 ;;
    esac
}

collect_domains() {
    domains=
    unknown=

    while IFS= read -r path; do
        [ -n "$path" ] || continue
        if domain=$(domain_for_path "$path"); then
            case " $domains " in
                *" $domain "*) ;;
                *) domains="$domains $domain" ;;
            esac
        else
            unknown="$unknown
$path"
        fi
    done

    if [ -n "$unknown" ]; then
        printf 'Unknown repository path(s):%s\n' "$unknown" >&2
        printf 'Add an explicit domain mapping before committing.\n' >&2
        return 2
    fi

    printf '%s\n' "$domains" | sed 's/^ *//'
}

current_branch() {
    git symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

require_main() {
    [ "$(current_branch)" = main ]
}

hooks_overridden() {
    [ "$(git config --bool --get hestia.hooks.override 2>/dev/null || true)" = true ]
}

staged_paths() {
    git diff --cached --name-only --diff-filter=ACDMRTUXB
}

validate_paths() {
    domains=$(staged_paths | collect_domains)
    [ -n "$domains" ] || exit 0

    set -- $domains
    if [ "$#" -gt 1 ]; then
        printf 'Warning: staged changes span domains:%s\n' "$domains" >&2
    fi
}

validate_message() {
    message_file=$1
    if [ -n "${2-}" ]; then
        domains=$(collect_domains < "$2")
    else
        domains=$(collect_domains)
    fi
    first_line=$(sed -n '1p' "$message_file")

    case "$first_line" in
        app:\ *|infra:\ *|memory:\ *|thesis:\ *) ;;
        *)
            printf 'Commit message must start with app:, infra:, memory:, or thesis:.\n' >&2
            return 1
            ;;
    esac

    prefix=${first_line%%:*}
    set -- $domains
    if [ "$#" -eq 1 ] && [ "$prefix" != "$1" ]; then
        printf 'Commit prefix "%s:" does not match staged domain "%s:".\n' "$prefix" "$1" >&2
        return 1
    fi

    if [ "$#" -gt 1 ]; then
        printf 'Warning: commit message covers multiple domains:%s\n' "$domains" >&2
    fi
}

case "${1-}" in
    paths)
        hooks_overridden && exit 0
        require_main || exit 0
        validate_paths
        ;;
    commit-message)
        hooks_overridden && exit 0
        require_main || exit 0
        validate_message "${2:?commit message file required}"
        ;;
    integration)
        validate_message "${2:?commit message file required}" "${3:?paths file required}"
        ;;
    *)
        printf 'Usage: %s paths|commit-message FILE|integration MESSAGE_FILE PATHS_FILE\n' "$0" >&2
        exit 64
        ;;
esac
