#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "psych"

staged = ARGV.empty?
paths = if staged
  stdout, status = Open3.capture2("git", "diff", "--cached", "--name-only", "--diff-filter=ACDMRTUXB", "-z")
  abort "Cannot list staged files.\n" unless status.success?
  stdout.split("\0").reject(&:empty?)
else
  ARGV
end

errors = []

paths.each do |path|
  if staged
    content, status = Open3.capture2("git", "show", ":#{path}")
    next unless status.success?
  else
    next unless File.file?(path)
    content = File.binread(path)
  end

  lines = content.lines
  lines.each_with_index do |line, index|
    if line.match?(/[ \t]+\r?\n?\z/)
      errors << "#{path}:#{index + 1}: trailing whitespace"
    end
  end

  if content.match?(/\n[ \t]*\n\z/)
    errors << "#{path}: trailing empty lines"
  end

  next unless path.match?(/\.(yaml|yml)\z/i)

  if content.match?(/^\t+/)
    errors << "#{path}: tab indentation is not allowed in YAML"
  end

  begin
    Psych.parse_stream(content)
  rescue Psych::SyntaxError => e
    errors << "#{path}: invalid YAML: #{e.message.lines.first.strip}"
  end
end

if errors.empty?
  puts "Staged formatting checks passed."
else
  warn errors.join("\n")
  exit 1
end
