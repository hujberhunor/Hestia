#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
checker="$repo_root/scripts/git-domain-check"
tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM

printf '%s\n' app/example.txt | "$checker" paths
printf '%s\n' app/example.txt > "$tmp_dir/paths"
printf 'app: add example\n' > "$tmp_dir/message"
"$checker" integration "$tmp_dir/message" "$tmp_dir/paths"
printf '%s\n' unknown/example.txt > "$tmp_dir/paths"
if "$checker" integration "$tmp_dir/message" "$tmp_dir/paths" 2>/dev/null; then
    printf 'Expected unknown path rejection.\n' >&2
    exit 1
fi

printf 'valid: true\n' > "$tmp_dir/valid.yml"
printf 'invalid: [true\n' > "$tmp_dir/invalid.yml"
ruby "$repo_root/scripts/check-staged-format" "$tmp_dir/valid.yml"
if ruby "$repo_root/scripts/check-staged-format" "$tmp_dir/invalid.yml" 2>/dev/null; then
    printf 'Expected invalid YAML rejection.\n' >&2
    exit 1
fi

git config --local hestia.hooks.override true
if ! "$checker" paths; then
    printf 'Expected local hook override.\n' >&2
    exit 1
fi
git config --local --unset hestia.hooks.override

printf 'Git domain checker basic tests passed.\n'
