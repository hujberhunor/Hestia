#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
[ "$branch" = main ] || exit 0
[ "$(git config --bool --get hestia.hooks.override 2>/dev/null || true)" = true ] && exit 0

"$repo_root/scripts/git-domain-check" paths
"$repo_root/scripts/check-staged-format"
